# Supabase PostgreSQL
# 從 Supabase: Connect → ORM → Prisma 取得；只填在 .env.local。
DATABASE_URL=
DIRECT_URL=

# 網站與管理員 session（後續登入功能會使用）
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=

# 開發環境初始管理員與測試分店；執行 npm run db:seed 前填寫。
SEED_HQ_USERNAME=
SEED_HQ_PASSWORD=
SEED_STORE_NAME=
SEED_STORE_ADDRESS=
SEED_STORE_PHONE=
SEED_STORE_USERNAME=
SEED_STORE_PASSWORD=

# LINE Login／LIFF（客戶身分驗證）
LINE_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=

# LINE Messaging API（Webhook 驗證與訊息發送）
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
